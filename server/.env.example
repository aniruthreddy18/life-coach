# Copy this file to ".env" (same folder) and fill in your values.
# NEVER share .env or push it to GitHub.

# Your Claude API key from https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Which Claude model to use. Cheaper option: claude-sonnet-5-5 or claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Port for the API server
PORT=3001

# Notification times (24h, your computer's local time)
MORNING_TIME=07:30
EVENING_TIME=21:00
NUDGE_TIME=22:30
