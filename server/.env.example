# Copy this file to ".env" (same folder) and fill in your values.
# NEVER share .env or push it to GitHub.
# After editing, run:  npm run doctor   (checks everything works)

# ---------------------------------------------------------------
# SUPABASE (sign-in with email OTP + the Postgres database)
# Dashboard: https://supabase.com/dashboard/project/wkamdfylxzaiyggvrqsh
# URL + publishable key are PUBLIC (safe in the browser) — already filled in.
# ---------------------------------------------------------------
SUPABASE_URL=https://wkamdfylxzaiyggvrqsh.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JjLbXfRKIoxiV3f1XPyP6g_oDIkw8Ya

# The database password is SECRET. Get this line from the dashboard:
#   "Connect" button (top of the page) -> "Session pooler" -> copy the URI,
#   then replace [YOUR-PASSWORD] with your database password.
# (Forgot it? Project Settings -> Database -> Reset database password.)
# It looks like:
# DATABASE_URL=postgresql://postgres.wkamdfylxzaiyggvrqsh:YOUR-PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------
# Which AI powers the coach: "openrouter", "openai", "gemini", "claude"
# or "none" (no AI at all: rules + templates only, completely free).
# You only need the key for the one you pick.
# ---------------------------------------------------------------
AI_PROVIDER=openrouter

# ---------------------------------------------------------------
# COST CONTROL
# Max AI spend per day in US dollars (0.05 ≈ ₹4/day ≈ ₹130/month max).
# When it's reached, the app uses the free model below (if set) or
# switches to rules/templates until tomorrow. 0 = no limit.
# ---------------------------------------------------------------
DAILY_BUDGET_USD=0.05
# Only used to show rupees in the app
INR_PER_USD=88

# "smart" model = level test, assessment + roadmap, weekly report
# "fast"  model = daily tasks, check-ins, chat
# Run `npm run models` to see every model your key can use.

# --- OpenRouter (one key, many models) ---
# Key: https://openrouter.ai/keys   Credits: https://openrouter.ai/credits
OPENROUTER_API_KEY=
OPENROUTER_MODEL_SMART=openai/gpt-6-sol
OPENROUTER_MODEL_FAST=openai/gpt-6-luna
# Optional: a free model (name ends with ":free") used when the daily budget
# is used up. Pick one from `npm run models` or openrouter.ai/models?q=free
# Leave empty to switch to rules mode instead.
OPENROUTER_MODEL_FREE=

# --- OpenAI direct (GPT) ---
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_SMART=gpt-6-luna
OPENAI_MODEL_FAST=gpt-6-luna

# --- Gemini (Google) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_SMART=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-latest

# --- Claude (Anthropic) ---
# Key: https://console.anthropic.com -> API Keys (needs credits)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMART=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# ---------------------------------------------------------------
# Server + notification times (24h, your computer's local time)
# ---------------------------------------------------------------
PORT=3001
MORNING_TIME=07:30
EVENING_TIME=21:00
NUDGE_TIME=22:30
