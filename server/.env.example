# Copy this file to ".env" (same folder) and fill in your values.
# NEVER share .env or push it to GitHub.

# ---------------------------------------------------------------
# Which AI powers the coach: "gemini" (free tier) or "claude"
# ---------------------------------------------------------------
AI_PROVIDER=gemini

# --- Gemini (Google) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "smart" = level test, assessment + roadmap, weekly report
# "fast"  = daily tasks, check-ins, chat
# gemini-flash-latest always points to Google's newest Flash model (free tier).
# Run `npm run models` to see every model your key can use.
GEMINI_MODEL_SMART=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-latest

# --- Claude (Anthropic) ---
# Key: https://console.anthropic.com -> API Keys (needs credits)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMART=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# ---------------------------------------------------------------
# Server + notification times (24h, your computer's local time)
# ---------------------------------------------------------------
PORT=3001
MORNING_TIME=07:30
EVENING_TIME=21:00
NUDGE_TIME=22:30
